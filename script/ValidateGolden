#!/usr/bin/env python3
"""Score listener output against the CUDA reference outputs, rendering only if asked to.

Scoring is a pure function of build/<listener>.bin and the reference bytes, and every solver
run leaves the former behind, so a session should render each scene at most once:

    script/ValidateGolden --score              # score what is already in build/, no renders
    script/ValidateGolden --profile            # render once: verdicts + wall + phase timings
    script/ValidateGolden                      # render, then score
    script/ValidateGolden LegoDrop Trumpet     # subset (either mode)

Results persist to build/validation.json so the README/VALIDATION tables regenerate with
--score. Rendered stdout/stderr lands in build/logs/<scene>.log. And if outputs are
byte-identical to a build whose metrics are recorded, the metrics are identical too —
`cmp` settles that more cheaply than re-rendering.

Reference outputs come from script/generate_golden_outputs.sh (gen/cuda/<scene>/<output>.bin).
"""

import argparse
import json
import os
import subprocess
import sys
import time

import numpy as np

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
build_dir = os.path.join(root, "build")
reference_dir = os.path.join(root, "gen", "cuda")
results_path = os.path.join(build_dir, "validation.json")


def config_path(scene):
    """Repo-owned override if there is one, else the dataset's own — Scenes/ is checksummed."""
    override = os.path.join(root, "config", scene + ".json")
    return override if os.path.isfile(override) else os.path.join(root, "Scenes", scene, "config.json")


parser = argparse.ArgumentParser(add_help=True)
parser.add_argument("scenes", nargs="*")
parser.add_argument("--score", action="store_true", help="score existing build/*.bin without rendering")
parser.add_argument("--profile", action="store_true", help="render with ACOUSTIC_PROFILE=1")
args = parser.parse_args()

scenes = args.scenes or sorted(
    s for s in os.listdir(reference_dir) if os.path.isdir(os.path.join(reference_dir, s))
)

results = {}
if os.path.exists(results_path):
    with open(results_path) as f:
        results = json.load(f)


def render(scene, config_path):
    """Runs the solver and returns its wall time, or None if it failed."""
    os.makedirs(os.path.join(build_dir, "logs"), exist_ok=True)
    env = dict(os.environ, ACOUSTIC_PROFILE="1") if args.profile else None
    t0 = time.time()
    result = subprocess.run(["./AcousticSolver", config_path], cwd=build_dir, capture_output=True, text=True, env=env)
    elapsed = time.time() - t0
    with open(os.path.join(build_dir, "logs", scene + ".log"), "w") as f:
        f.write(result.stdout + result.stderr)
    if result.returncode != 0:
        print(f"  SOLVER FAILED (exit {result.returncode}) in {elapsed:.1f}s")
        print("  " + "\n  ".join(result.stderr.splitlines()[-5:]))
        return None
    return elapsed


def score(name, srate):
    """Metrics for one listener's output against its CUDA reference at the same rate."""
    metal = np.fromfile(os.path.join(build_dir, name + ".bin"), dtype=np.float32)
    cuda = np.fromfile(os.path.join(reference_dir, scene, str(srate), name + ".bin"), dtype=np.float32)
    n = min(len(metal), len(cuda))
    m, c = metal[:n].astype(np.float64), cuda[:n].astype(np.float64)

    rel_l2 = np.linalg.norm(m - c) / max(np.linalg.norm(c), 1e-300)
    corr = np.corrcoef(m, c)[0, 1] if n > 1 else float("nan")
    neq = np.nonzero(metal[:n] != cuda[:n])[0]
    exact_prefix = (neq[0] if len(neq) else n) / srate

    rms_ratio = np.sqrt((m**2).mean()) / max(np.sqrt((c**2).mean()), 1e-300)
    frame, hop = 1024, 512
    window = np.hanning(frame)
    spec_m = np.abs(np.fft.rfft(np.lib.stride_tricks.sliding_window_view(m, frame)[::hop] * window, axis=1))
    spec_c = np.abs(np.fft.rfft(np.lib.stride_tricks.sliding_window_view(c, frame)[::hop] * window, axis=1))
    spec_err = np.linalg.norm(spec_m - spec_c) / max(np.linalg.norm(spec_c), 1e-300)

    # Cross-platform reproducibility limits, established against the CUDA reference:
    # scenes whose sources are pure functions of time (speaker audio) track the reference
    # to ulp-accumulation level (rel_l2 ~ 1e-5..1e-4, corr ~ 1). Scenes driven by CPU ODE
    # systems (coupled bubbles, modal impacts, fresh-cell least squares) amplify ARM-vs-x86
    # libm/Eigen ulp differences into waveform phase decorrelation — verified by running the
    # CPU-only FluidSound solver on both platforms (rel_l2 0.40, corr 0.92, GlassPour, with
    # no GPU involved). For those, energy envelope and magnitude spectrogram are the
    # meaningful invariants. A structural port bug fails both gates.
    waveform_ok = rel_l2 < 1e-2 and corr > 0.999
    envelope_ok = 0.8 < rms_ratio < 1.25 and spec_err < 0.35
    status = "OK" if waveform_ok else "OK(env)" if envelope_ok else "FAIL"
    return {
        "status": status, "rel_l2": rel_l2, "corr": corr, "rms_ratio": rms_ratio,
        "spec_err": spec_err, "bitexact_prefix": exact_prefix, "duration": n / srate,
        "length_mismatch": len(metal) != len(cuda),
    }


failures = 0
for scene in scenes:
    with open(config_path(scene)) as f:
        config = json.load(f)
    srate = config["FDTD_srate"]

    print(f"=== {scene} (tf={config['tf']}s @ {srate} Hz) ===", flush=True)
    entry = results.setdefault(scene, {})
    if not args.score:
        elapsed = render(scene, config_path(scene))
        if elapsed is None:
            failures += 1
            continue
        entry["wall"] = elapsed
        entry["rendered"] = time.strftime("%Y-%m-%d %H:%M")

    missing = [l["output"] for l in config["listeners"].values()
               if not os.path.exists(os.path.join(build_dir, l["output"] + ".bin"))]
    if missing:
        print(f"  NO OUTPUT for {', '.join(missing)} — render this scene first (drop --score)")
        failures += 1
        continue

    wall = entry.get("wall")
    entry["listeners"] = {}
    for listener in config["listeners"].values():
        name = listener["output"]
        m = score(name, srate)
        entry["listeners"][name] = m
        if m["length_mismatch"]:
            print(f"  {name}: LENGTH MISMATCH")
            failures += 1
        if m["status"] == "FAIL":
            failures += 1
        print(
            f"  {name}: {m['status']}  rel_l2={m['rel_l2']:.3e}  corr={m['corr']:.6f}"
            f"  rms_ratio={m['rms_ratio']:.4f}  spec_err={m['spec_err']:.3e}"
            f"  bitexact_prefix={m['bitexact_prefix']:.2f}s/{m['duration']:.2f}s"
            f"  ({f'{wall:.1f}s wall' if wall else 'not timed this run'})"
        )

with open(results_path, "w") as f:
    json.dump(results, f, indent=1)

# Table rows for VALIDATION.md / README, from the persisted results
print("\n| Scene | Verdict | rel L2 | corr | RMS ratio | spec err | wall |")
print("|---|---|---|---|---|---|---|")
total = 0.0
for scene in scenes:
    entry = results.get(scene, {})
    for name, m in entry.get("listeners", {}).items():
        wall = entry.get("wall")
        total += wall or 0.0
        print(
            f"| {scene} | {m['status']} | {m['rel_l2']:.1e} | {m['corr']:.6f} |"
            f" {m['rms_ratio']:.4f} | {m['spec_err']:.1e} | {f'{wall:.1f}s' if wall else '-'} |"
        )
print(f"| **Total** | | | | | | **{total:.1f}s** |")

sys.exit(1 if failures else 0)
