#!/bin/bash

ScriptDir="$(cd "$(dirname "${0}")" && pwd)"
ProjectRootDir="$(dirname "${ScriptDir}")"

# Third-party code under src/ThirdParty is excluded via a per-directory .clang-format
# with DisableFormat.
find -E "${ProjectRootDir}/src" "${ProjectRootDir}/main.cpp" -regex '.*\.(cpp|hpp|c|cc|cxx|h|hh)' -exec clang-format -style=file -i {} \;
