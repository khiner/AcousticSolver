#!/usr/bin/env python3
"""Render listenable WAVs from raw listener output (.bin float32 pressure samples).

Usage (from anywhere):
    script/RenderWavs                # all scenes with reference and/or Metal output
    script/RenderWavs GlassPour ...  # just these scenes

For each scene, writes gen/wav/cuda/<scene>.wav from gen/cuda/<scene>/<output>.bin and
gen/wav/metal/<scene>.wav from build/<output>.bin, whichever exist. Follows the reference
write_wav.py convention: peak-normalized, at the scene's FDTD sample rate.
Pure CPU — no GPU needed. Requires numpy + soundfile.
"""

import json
import os
import sys

import numpy as np
import soundfile as sf

root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
reference_dir = os.path.join(root, "gen", "cuda")
build_dir = os.path.join(root, "build")

def config_path(scene):
    """Repo-owned override if there is one, else the dataset's own — Scenes/ is checksummed."""
    override = os.path.join(root, "config", scene + ".json")
    return override if os.path.isfile(override) else os.path.join(root, "Scenes", scene, "config.json")

wav_dir = os.path.join(root, "gen", "wav")
# Filed by rate, like the references, so retiming a scene does not overwrite its old rendering.

scenes = sys.argv[1:] or sorted(
    s for s in os.listdir(reference_dir) if os.path.isdir(os.path.join(reference_dir, s))
)


def render(bin_path, wav_path, srate):
    data = np.fromfile(bin_path, dtype=np.float32)
    if peak := np.abs(data).max():
        data = data / peak
    sf.write(wav_path, data, srate)
    return len(data) / srate


for scene in scenes:
    with open(config_path(scene)) as f:
        config = json.load(f)
    srate = config["FDTD_srate"]

    rendered = []
    for listener in config["listeners"].values():
        name = listener["output"]
        for kind, bin_path in (
            ("cuda", os.path.join(reference_dir, scene, str(srate), name + ".bin")),
            ("metal", os.path.join(build_dir, name + ".bin")),
        ):
            if os.path.exists(bin_path):
                out_dir = os.path.join(wav_dir, kind, scene)
                os.makedirs(out_dir, exist_ok=True)
                duration = render(bin_path, os.path.join(out_dir, f"{srate}.wav"), srate)
                rendered.append(f"{kind} ({duration:.1f}s)")
    print(f"{scene}: {' + '.join(rendered) if rendered else 'no output found'} @ {srate} Hz")
