# Build the same Helmholtz/Laplace FMM library used by BoundaryIntegralEquations.jl.
find_program(CMAKE_Fortran_COMPILER NAMES gfortran HINTS /opt/homebrew/bin REQUIRED)
enable_language(Fortran)
find_package(OpenMP REQUIRED COMPONENTS Fortran)
set(FMM3D_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/external/fmm3d")
set(FMM3D_SOURCES)
foreach(name besseljs3d cdjseval3d dfft fmmcommon legeexps prini rotgen rotproj rotviarecur tree_routs3d pts_tree3d yrecursion cumsum)
    list(APPEND FMM3D_SOURCES "${FMM3D_ROOT}/src/Common/${name}.f")
endforeach()
foreach(name h3dcommon h3dterms h3dtrans helmrouts3d hfmm3d hfmm3dwrap hfmm3dwrap_vec hpwrouts hwts3e hnumphys hnumfour projections hfmm3d_ndiv helmkernels hndiv)
    list(APPEND FMM3D_SOURCES "${FMM3D_ROOT}/src/Helmholtz/${name}.f")
endforeach()
foreach(name lwtsexp_sep1 l3dterms l3dtrans laprouts3d lfmm3d lfmm3dwrap lfmm3dwrap_vec lwtsexp_sep2 lpwrouts lfmm3d_ndiv lapkernels lndiv)
    list(APPEND FMM3D_SOURCES "${FMM3D_ROOT}/src/Laplace/${name}.f")
endforeach()
add_library(Fmm3d STATIC ${FMM3D_SOURCES})
target_compile_options(Fmm3d PRIVATE -O3 -std=legacy -w)
target_link_libraries(Fmm3d PUBLIC OpenMP::OpenMP_Fortran)
