#!/usr/bin/env python3
"""Prepare linear/quadratic surface elements from Gmsh/COMSOL, or generate a sphere demo."""
import argparse
import json
from pathlib import Path
from thermoviscous.mesh import mesh, sphere

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('output',type=Path)
    parser.add_argument('--mesh',type=Path,help='Gmsh .msh or COMSOL .mphtxt with outward winding')
    parser.add_argument('--level',type=int,default=1,choices=range(5),help='Sphere subdivision level')
    parser.add_argument('--radius',type=float,default=.01,help='Sphere radius in metres')
    parser.add_argument('--frequency',type=float,default=1000)
    parser.add_argument('--interior',action='store_true')
    parser.add_argument('--physics-order',choices=['geometry','linear','quadratic'],default='geometry')
    parser.add_argument('--discontinuous',action='store_true')
    parser.add_argument('--backend',choices=['dense','fmm','hmatrix'],default='dense')
    args = parser.parse_args()
    vertices,faces = mesh(args.mesh) if args.mesh else sphere(args.level,args.radius)
    scene = {'vertices':vertices.tolist(),'triangles':[list(map(int,t)) for t in faces if len(t) in (3,6)],
             'quadrilaterals':[list(map(int,t)) for t in faces if len(t) in (4,8,9)],'frequency':args.frequency,
             'exterior':not args.interior,'velocity':[0,0,.01], 'quadrature':6,'physics_order':args.physics_order,'discontinuous':args.discontinuous,'acoustic_backend':args.backend}
    if not args.mesh:
        scene['receivers'] = [[0,0,args.radius*(.5 if args.interior else 2)]]
    args.output.parent.mkdir(parents=True,exist_ok=True)
    args.output.write_text(json.dumps(scene,separators=(',',':'))+'\n')
    print(f'{len(vertices)} nodes, {len(faces)} elements: {args.output}')


if __name__ == '__main__':
    main()
