#!/usr/bin/env python3
"""Solve a NumCalc JSON scene and write complex boundary/receiver fields."""
import argparse
import json
from pathlib import Path
from numcalc.common import ROOT, run

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('scene', type=Path)
parser.add_argument('--output', type=Path, default=ROOT/'build/numcalc')
parser.add_argument('--backend', choices=['cpu', 'metal'], default='cpu')
parser.add_argument('--reference', action='store_true')
parser.add_argument('--benchmark', type=int, default=0, metavar='REPEATS')
args = parser.parse_args()
result = run(json.loads(args.scene.read_text()), args.output, args.backend, args.reference, args.benchmark)
print(f"{args.output.resolve() / 'result.json'} ({result['wall_seconds']:.3f} s)")
