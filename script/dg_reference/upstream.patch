--- /dev/null
+++ b/solvers/acoustics/reference.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include "acoustics.h"
+#include <fstream>
+#include <iomanip>
+#include <stdexcept>
+
+namespace dgref {
+inline std::string directory() {
+    const char *path = std::getenv("DG_REFERENCE_OUTPUT");
+    if (!path || !*path) throw std::runtime_error("DG_REFERENCE_OUTPUT is required");
+    return path;
+}
+
+template<class T> inline void write(const std::string &name, const T *values, size_t count) {
+    std::ofstream file(directory() + "/" + name + ".bin", std::ios::binary);
+    file.write(reinterpret_cast<const char *>(values), count * sizeof(T));
+    if (!file) throw std::runtime_error("could not write reference array: " + name);
+}
+
+inline void buffer(const std::string &name, const occa::memory &memory) {
+    if (!memory.isInitialized()) return;
+    std::vector<unsigned char> bytes(memory.size());
+    memory.copyTo(bytes.data());
+    write(name, bytes.data(), bytes.size());
+}
+
+inline void metadata(acoustics_t *a) {
+    auto *m = a->mesh;
+    int ranks;
+    MPI_Comm_size(m->comm, &ranks);
+    if (ranks != 1) throw std::runtime_error("reference capture requires one MPI rank");
+    if (a->NReceiversLocal != a->NReceivers) throw std::runtime_error("not all reference receivers were located");
+    std::ofstream out(directory() + "/solver.json");
+    out << std::setprecision(17)
+        << "{\n\"scalar_bytes\":" << sizeof(dfloat)
+        << ",\n\"backend\":\"" << m->device.mode() << "\""
+        << ",\n\"index_bytes\":" << sizeof(dlong)
+        << ",\n\"elements\":" << m->Nelements
+        << ",\n\"degree\":" << m->N
+        << ",\n\"nodes_per_element\":" << m->Np
+        << ",\n\"nodes_per_face\":" << m->Nfp
+        << ",\n\"faces_per_element\":" << m->Nfaces
+        << ",\n\"fields\":" << a->Nfields
+        << ",\n\"curved_elements\":" << m->Ncurv
+        << ",\n\"steps\":" << m->NtimeSteps
+        << ",\n\"dt\":" << double(m->dt)
+        << ",\n\"samples\":" << a->timeStepsOut.size()
+        << ",\n\"receivers\":" << a->NReceiversLocal
+        << "\n}\n";
+    if (!out) throw std::runtime_error("could not write reference metadata");
+    write("times", a->timeStepsOut.data(), a->timeStepsOut.size());
+    write("receiver_xyz", a->recvXYZ, 3 * a->NReceivers);
+}
+
+inline void mesh(acoustics_t *a) {
+    auto *m = a->mesh;
+    buffer("initial_q", a->o_q);
+    buffer("vmapM", m->o_vmapM);
+    buffer("vmapP", m->o_vmapP);
+    buffer("EToB", m->o_EToB);
+    buffer("x", m->o_x);
+    buffer("y", m->o_y);
+    buffer("z", m->o_z);
+    buffer("receiver_interpolation", a->o_recvintpol);
+    buffer("receiver_elements", a->o_recvElements);
+}
+
+inline void receivers(acoustics_t *a) {
+    buffer("final_q", a->o_q);
+    write("receivers", a->qRecv, size_t(a->NReceiversLocal) * a->timeStepsOut.size());
+}
+} // namespace dgref
